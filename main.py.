import os
import logging
import platform
import shutil
from dotenv import load_dotenv

# --- SETUP AWAL ---
load_dotenv()
logging.basicConfig(
    filename='quantum.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)

# Definisi Warna
G = "\033[92m"  # Hijau
Y = "\033[93m"  # Kuning
B = "\033[94m"  # Biru
R = "\033[91m"  # Merah
W = "\033[0m"   # Putih

def get_sys_info():
    """Fungsi Backend untuk mengambil spek HP"""
    return {
        "Sistem": platform.system(),
        "Node": platform.node(),
        "Python": platform.python_version(),
        "Mesin": platform.machine()
    }

def main():
    while True:
        os.system('clear')
        # Tampilan Header
        print(f"{B}====================================={W}")
        print(f"{G}      WELCOME BACK, MASTER AULUNG      {W}")
        print(f"{B}====================================={W}")
        print(f"{G}[1]{R} Ganti Nama Master")
        print(f"{G}[2]{R} Quantum System Info")
        print(f"{G}[3]{R} Bersihkan Sampah (Cache)")
        print(f"{G}[4]{R} Keluar & Auto-Sync GitHub")
        print(f"{B}====================================={W}")

        pilih = input(f"\n{Y}Pilih Menu:{R} ")

        if pilih == '1':
            nama = input(f"{G}Masukkan Nama Baru: {W}")
            logging.info(f"Master berganti nama jadi: {nama}")
            input(f"{G}[+] Nama Updated! Press Enter...")

        elif pilih == '2':
            # --- MENU NO 2 (SUDAH FIX) ---
            print(f"\n{B}--- QUANTUM SYSTEM INFO ---{W}")
            info = get_sys_info()
            for k, v in info.items():
                print(f"{G}{k:<10} : {W}{v}")
            logging.info("User melihat info sistem")
            input(f"\n{Y}Tekan Enter untuk kembali...")

        elif pilih == '3':
            # --- MENU NO 3 (AUTO CLEAN) ---
            print(f"\n{Y}[!] Sedang membersihkan cache...{W}")
            count = 0
            for root, dirs, files in os.walk('.'):
                if '__pycache__' in dirs:
                    shutil.rmtree(os.path.join(root, '__pycache__'))
                    count += 1
            logging.info(f"Bersihkan cache: {count} folder")
            input(f"{G}[+] Berhasil hapus {count} folder cache! Enter...")

        elif pilih == '4':
            # --- MENU NO 4 (SYNC & EXIT) ---
            print(f"{Y}[!] Sinkronisasi ke GitHub...{W}")
            # Pastikan venv aktif biar requirements.txt akurat
            os.system("pip freeze > requirements.txt")
            os.system("git add . && git commit -m 'Auto-sync Quantum' && git push origin main")
            print(f"{G}[+] Data aman di Cloud. Sampai jumpa!")
            break

if __name__ == "__main__":
    main()
